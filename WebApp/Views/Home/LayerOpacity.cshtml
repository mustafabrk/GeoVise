<form id="layer-opacity">
    <div class="card">
        <h2 class="form-title">Katman Opaklığı</h2>
        <div class="form-group">
            <label for="point-range" class="form-label">Nokta Katmanı</label>
            <input class="change-opacity form-range" id="point-range" type="range" min="0" max="100" value="100" data-layer="point-layer">
@*            <span class="form-value" id="point-value">100</span>
*@        </div>

        <div class="form-group">
            <label for="line-range" class="form-label">Çizgi Katmanı</label>
            <input class="change-opacity form-range" id="line-range" type="range" min="0" max="100" value="100" data-layer="line-layer">
@*            <span class="form-value" id="line-value">100</span>
*@        </div>

        <div class="form-group">
            <label for="polygon-range" class="form-label">Poligon Katmanı</label>
            <input class="change-opacity form-range" id="polygon-range" type="range" min="0" max="100" value="100" data-layer="polygon-layer">
@*            <span class="form-value" id="polygon-value">100</span>
*@        </div>
    </div>
</form>
